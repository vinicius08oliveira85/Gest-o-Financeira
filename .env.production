# Configuração pública do Appwrite usada no build de produção (Vercel).
# Estes valores são embutidos no bundle pelo Vite e são públicos por natureza
# (endpoint + Project ID), como em qualquer app que fala direto com o backend.
# Variáveis definidas no painel da Vercel têm precedência sobre este arquivo.
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6af37cdf003b7bb053df
VITE_APPWRITE_DATABASE_ID=gestao_financeira
