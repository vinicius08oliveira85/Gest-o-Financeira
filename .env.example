# Supabase: sincronização dos registros (dívidas/caixa).
# Obtenha em: Supabase Dashboard > Project Settings > API Keys.
# Use a chave publishable (sb_publishable_...) ou a anon public; nunca a secret/service_role.
# Sem essas variáveis, o app usa apenas localStorage.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-publishable-ou-anon-key"
