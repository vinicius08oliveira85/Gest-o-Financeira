# Appwrite: sincronização dos registros (lançamentos, metas, cartões, empréstimos).
# Obtenha o endpoint e o Project ID em: Appwrite Console > Overview > Settings.
# Sem essas variáveis o app usa apenas o armazenamento local (localStorage).
VITE_APPWRITE_ENDPOINT="https://nyc.cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="seu-project-id"
# Opcional: id do banco criado pelo script de setup (padrão: gestao_financeira).
VITE_APPWRITE_DATABASE_ID="gestao_financeira"

# Só para rodar `npm run setup:appwrite` (nunca vai para o bundle).
# Crie em Appwrite Console > Overview > Integrations > API keys com escopos de
# databases, collections, attributes, indexes e documents.
# APPWRITE_API_KEY="sua-api-key"
